# CONFIG_ACPI_PROCESSOR_AGGREGATOR is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set
CONFIG_COMPACT_UNEVICTABLE_DEFAULT=0
# CONFIG_CPU_FREQ_GOV_CONSERVATIVE is not set
# CONFIG_CPU_FREQ_GOV_ONDEMAND is not set
# CONFIG_CPU_FREQ_GOV_POWERSAVE is not set
# CONFIG_CPU_FREQ_GOV_USERSPACE is not set
# CONFIG_CPU_FREQ_STAT is not set
# CONFIG_CPU_IDLE_GOV_MENU is not set
CONFIG_HWLAT_TRACER=y
CONFIG_HZ=1000
# CONFIG_HZ_100 is not set
CONFIG_HZ_1000=y
# CONFIG_INTEL_IDLE is not set
CONFIG_IRQSOFF_TRACER=y
# CONFIG_NO_HZ is not set
CONFIG_NO_HZ_FULL=y
# CONFIG_NO_HZ_IDLE is not set
CONFIG_OSNOISE_TRACER=y
# CONFIG_PM is not set
CONFIG_PREEMPT=y
CONFIG_PREEMPT_RT=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_TRACER_SNAPSHOT=y
CONFIG_VIRT_CPU_ACCOUNTING_GEN=y
# CONFIG_X86_ACPI_CPUFREQ is not set
CONFIG_X86_CPU_RESCTRL=y
# CONFIG_X86_P4_CLOCKMOD is not set
# CONFIG_X86_PCC_CPUFREQ is not set
# CONFIG_XEN is not set
CONFIG_ARCH_HAS_CPU_RESCTRL=y
CONFIG_CONTEXT_TRACKING_USER=y
# CONFIG_CONTEXT_TRACKING_USER_FORCE is not set
CONFIG_PREEMPTIRQ_TRACEPOINTS=y
# CONFIG_PREEMPT_RT_NEEDS_BH_LOCK is not set
CONFIG_PROC_CPU_RESCTRL=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
# CONFIG_RCU_LAZY is not set
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_CB_BOOST=y
# CONFIG_RCU_NOCB_CPU_DEFAULT_ALL is not set
CONFIG_RESCTRL_FS=y
CONFIG_RESCTRL_FS_PSEUDO_LOCK=y
CONFIG_RING_BUFFER_ALLOW_SWAP=y
CONFIG_TRACER_MAX_TRACE=y
CONFIG_TRACER_SNAPSHOT_PER_CPU_SWAP=y
CONFIG_TRACE_IRQFLAGS=y
CONFIG_TRACE_IRQFLAGS_NMI=y
CONFIG_VIRT_CPU_ACCOUNTING=y
CONFIG_X86_DISABLED_FEATURE_XENPV=y
CONFIG_X86_REQUIRED_FEATURE_PGE=y
CONFIG_X86_REQUIRED_FEATURE_PSE=y
